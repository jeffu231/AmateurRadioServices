{
  "Aprs": {
    "BaseAddress": "https://api.aprs.fi",
    "ApiKey": "",
    "UserAgent": "www.k9kld.org",
    "TimeoutSeconds": 15,
    "ResponseSizeLimitBytes": 1048576
  },
  "Qrz": {
    "BaseAddress": "https://xmldata.qrz.com",
    "Username": "",
    "Password": "",
    "AgentIdentifier": "ARUv1.0",
    "UserAgent": "Mozilla/5.0",
    "TimeoutSeconds": 15,
    "ResponseSizeLimitBytes": 1048576
  },
  "RateLimiting": {
    "Enabled": true,
    "PublicPermitLimit": 60,
    "WindowSeconds": 60,
    "QueueLimit": 0,
    "GlobalConcurrencyPermitLimit": 8
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      },
      "FormatterName": "json",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "MM/dd/yyy HH:mm:ss ",
        "UseUtcTimestamp": false
      }
    }
  },
  "AllowedHosts": "*"
}
